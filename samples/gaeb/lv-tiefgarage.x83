      </BoQInfo>
      <BoQBody>
        <BoQCtgy ID="01" RNoPart="01">
          <LblTx>
            <span>Starkstromanlage</span>
          </LblTx>
          <BoQBody>
            <Itemlist>
              <Item ID="01.0010" RNoPart="0010">
                <Qty>24</Qty>
                <QU>Stk</QU>
                <Description>
                  <CompleteText>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <span>Feuchtraumsteckdose</span>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                    <DetailTxt>
                      <Text>
                        <span>Feuchtraumsteckdose IP44 setzen und anschließen, inkl. Kleinteile.</span>
                      </Text>
                    </DetailTxt>
                  </CompleteText>
                </Description>
                <UP>86.00</UP>
                <IT>2064.00</IT>
              </Item>
              <Item ID="01.0020" RNoPart="0020">
                <Qty>180</Qty>
                <QU>m</QU>
                <Description>
                  <CompleteText>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <span>Mantelleitung NYM-J 5x2,5</span>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                    <DetailTxt>
                      <Text>
                        <span>Mantelleitung auf Pritsche verlegen und befestigen.</span>
                      </Text>
                    </DetailTxt>
                  </CompleteText>
                </Description>
                <UP>6.40</UP>
                <IT>1152.00</IT>
              </Item>
              <Item ID="01.0030" RNoPart="0030">
                <Qty>6</Qty>
                <QU>Stk</QU>
                <Description>
                  <CompleteText>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <span>LED-Feuchtraumleuchte</span>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                    <DetailTxt>
                      <Text>
                        <span>Feuchtraumleuchte 1200 mm liefern, montieren und anschließen.</span>
                      </Text>
                    </DetailTxt>
                  </CompleteText>
                </Description>
                <UP>149.00</UP>
                <IT>894.00</IT>
              </Item>
            </Itemlist>
